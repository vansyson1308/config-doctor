{
  "name": "config-doctor",
  "version": "0.1.0",
  "description": "Config Doctor for Jira: deterministic, auditable Jira access and configuration diagnostics, explained by a Rovo agent.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "forge lint",
    "seed": "node --env-file=.env --experimental-strip-types scripts/seed/seed.ts"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/bridge": "^7.2.1",
    "@forge/events": "^3.0.9",
    "@forge/kvs": "^2.1.1",
    "@forge/react": "^12.4.0",
    "@forge/resolver": "^2.0.2",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
