# Used ONLY by the local demo-data seeder (scripts/seed). Never by the Forge app.
# Target = the Forge demo site (Rovo enabled). The token works on any site your account administers.
# Create a classic API token at https://id.atlassian.com/manage-profile/security/api-tokens
# (the owner's own Jira admin account). Copy this file to .env and fill it in.
JIRA_BASE_URL=https://one-atlas-sery.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
